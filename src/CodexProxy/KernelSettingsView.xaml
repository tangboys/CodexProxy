<UserControl x:Class="CodexProxy.KernelSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F9FF" FontFamily="Microsoft YaHei UI" Foreground="#172B3A">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,26">
      <TextBlock Text="{DynamicResource KernelSettingsTitle}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource KernelDescription}" TextWrapping="Wrap" Foreground="#718AA3" Margin="0,10,0,0"/>
      <Border Background="#EAF3FF" CornerRadius="10" Padding="16" Margin="0,20,0,16"><StackPanel><TextBlock Text="{DynamicResource CurrentKernel}" Foreground="#2475D4" FontWeight="SemiBold"/><TextBlock x:Name="CurrentPathText" TextWrapping="Wrap" FontSize="11" Foreground="#526A79" Margin="0,7,0,0"/></StackPanel></Border>
      <DockPanel Margin="0,0,0,10"><WrapPanel DockPanel.Dock="Right"><Button x:Name="DetectButton" Content="{DynamicResource DetectKernels}" Click="DetectClick" FontSize="12" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="BrowseButton" Content="{DynamicResource ChooseKernelFile}" Click="BrowseClick" FontSize="12" Padding="12,8"/></WrapPanel><TextBlock Text="{DynamicResource AvailableKernels}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <ListBox x:Name="KernelList" MinHeight="180" MaxHeight="360" BorderBrush="#DDE8F5" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectionChanged">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="14,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Path}" Foreground="#718AA3" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Margin="0,12,0,0"><Button x:Name="UpdateButton" Content="{DynamicResource CheckKernelUpdate}" Click="CheckUpdateClick" Padding="12,8" FontSize="12" Margin="0,0,8,0"/><Button Content="{DynamicResource OpenKernelReleases}" Click="OpenReleasesClick" Padding="12,8" FontSize="12"/></WrapPanel>
      <TextBlock x:Name="MessageLabel" Text="{DynamicResource KernelSwitchHint}" TextWrapping="Wrap" Foreground="#718AA3" FontSize="12" Margin="0,18,0,16"/>
      <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#2475D4" Margin="0,0,0,12"/>
      <WrapPanel HorizontalAlignment="Right"><Button x:Name="CancelButton" Click="CancelClick" Margin="0,0,9,0" IsEnabled="False"/><Button x:Name="ApplyButton" Content="{DynamicResource ApplyKernel}" Click="ApplyClick" Style="{StaticResource Primary}"/></WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
