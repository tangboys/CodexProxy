<Window x:Class="CodexProxy.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AppUpdateTitle}" Icon="Assets/app.ico" Width="740" Height="610" MinWidth="650" MinHeight="550" WindowStartupLocation="CenterOwner" Background="#F5F9FF" FontFamily="Microsoft YaHei UI" Foreground="#172B3A">
  <Grid Margin="30,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{DynamicResource AppUpdateTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource AppUpdateDescription}" TextWrapping="Wrap" Foreground="#718AA3" Margin="0,10,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="#EAF3FF" CornerRadius="10" Padding="16" Margin="0,20,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource CurrentAppVersion}" Foreground="#718AA3"/><TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource LatestAppVersion}" Foreground="#718AA3" Margin="0,10,0,0"/><TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold" Foreground="#2475D4" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Grid.Row="2" Text="{DynamicResource AppReleasePublished}" Foreground="#718AA3" Margin="0,10,0,0"/><TextBlock x:Name="PublishedText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,10,0,0"/>
      </Grid>
    </Border>
    <TextBlock x:Name="NetworkHint" Grid.Row="2" Foreground="#718AA3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource AppReleaseNotes}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="NotesText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#DDE8F5" Padding="12" FontSize="12"/>
    </Grid>
    <TextBlock x:Name="MessageLabel" Grid.Row="4" TextWrapping="Wrap" Foreground="#526A79" FontSize="12" Margin="0,16,0,14"/>
    <StackPanel Grid.Row="5"><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#2475D4" Margin="0,0,0,12"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="{DynamicResource CancelAppUpdate}" Click="CancelClick" IsEnabled="False" Margin="0,0,8,0"/><Button Content="{DynamicResource OpenAppReleases}" Click="OpenReleasesClick" Margin="0,0,8,0"/><Button Content="{DynamicResource Done}" Click="DoneClick" Margin="0,0,8,0"/><Button x:Name="CheckButton" Content="{DynamicResource CheckAppUpdates}" Click="CheckClick" Style="{StaticResource Primary}"/></WrapPanel></StackPanel>
  </Grid>
</Window>
