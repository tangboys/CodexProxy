<Window x:Class="CodexProxy.SubscriptionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource SubscriptionSettingsTitle}" Icon="Assets/app.ico" Width="900" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Microsoft YaHei UI" Foreground="#172B3A">
  <Grid Margin="30,26,30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{DynamicResource SubscriptionSettingsTitle}" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SavedLabel" Text="{DynamicResource SubscriptionDescription}" Foreground="#82909D" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
    <Grid x:Name="Editor" Grid.Row="1" Margin="0,24,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button x:Name="AddButton" DockPanel.Dock="Right" Content="{DynamicResource AddNew}" Click="AddClick" Padding="11,7" FontSize="12"/><TextBlock Text="{DynamicResource MySubscriptions}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <ListBox x:Name="SubscriptionList" Grid.Row="1" SelectionChanged="SelectionChanged" BorderBrush="#E5EAF0" Background="#F9FAFC" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#2475D4" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Host}" Foreground="#82909D" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <StackPanel Grid.Column="2">
        <DockPanel Margin="0,0,0,16"><Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="{DynamicResource DeleteSubscription}" Click="DeleteClick" FontSize="11" Padding="10,6"/><TextBlock x:Name="EntryTitle" Text="{DynamicResource NewSubscription}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="{DynamicResource SubscriptionName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="NameText" AutomationProperties.Name="{DynamicResource SubscriptionName}" Margin="0,0,0,17"/>
        <TextBlock Text="{DynamicResource SubscriptionLink}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <PasswordBox x:Name="UrlPassword" AutomationProperties.Name="{DynamicResource SubscriptionLink}"/>
        <TextBox x:Name="UrlText" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource VisibleSubscriptionLink}"/>
        <CheckBox x:Name="ShowUrl" Content="{DynamicResource ShowSubscriptionLink}" Click="ShowUrlClick" FontSize="11" Foreground="#82909D" Margin="0,9,0,12"/>
        <TextBlock x:Name="UrlHint" Text="{DynamicResource SavedUrlHint}" Foreground="#82909D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="{DynamicResource MihomoCoreLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CorePath" AutomationProperties.Name="{DynamicResource MihomoCorePath}" ToolTip="{DynamicResource MihomoCoreHint}"/><Button x:Name="BrowseButton" Grid.Column="1" Content="{DynamicResource Browse}" Click="BrowseClick" Margin="8,0,0,0" Padding="12,8"/></Grid>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#926C2B" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,14" Text="{DynamicResource SubscriptionSaveHint}"/>
    <StackPanel Grid.Row="3"><ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Foreground="#2475D4" Visibility="Collapsed" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="{DynamicResource Done}" Click="CancelClick" Margin="0,0,9,0"/><Button x:Name="SaveButton" Content="{DynamicResource Save}" Click="SaveClick" Margin="0,0,9,0"/><Button x:Name="ActivateButton" Content="{DynamicResource SaveAndEnable}" Style="{StaticResource Primary}" Click="ActivateClick"/></StackPanel></StackPanel>
  </Grid>
</Window>
